# 复制成 .env 使用；.env 不要提交到 git
# 视频工作台的访问令牌（登录用，不是卡密）
DOLA_CREDENTIAL=

# 可选：换站点地址 / 默认 provider。dola-workbench 是已验证的固定 30 秒工作台。
# DOLA_BASE_URL=https://43.254.166.145
# VIDEO_PROVIDER=dola-workbench

# 新版 Bearer Token API（契约来源：新Dola_API接口说明.md）。
# 它和上面的旧工作台是两套认证方式，不能混用令牌。
# DOLA_API_TOKEN=
# DOLA_API_BASE_URL=https://43.254.166.196
# VIDEO_PROVIDER=dola-api

# admin-dola 只有在订阅账号上完成真实 30 秒验证后才可显式打开；否则用户端会 fail-closed。
# ADMIN_DOLA_FIXED_SECONDS_VERIFIED=false

# 可选：站点证书校验异常时才开（实测当前证书可正常校验，不需要）
# NODE_TLS_REJECT_UNAUTHORIZED=0
